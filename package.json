{
  "name": "cadna-mart-backend",
  "version": "0.0.1",
  "description": "Cadna Mart Backend - Enterprise NestJS API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "prisma generate && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=dev nest start --watch",
    "start:debug": "NODE_ENV=dev nest start --debug --watch",
    "start:staging": "NODE_ENV=staging node dist/main",
    "start:prod": "NODE_ENV=prod node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.typecheck.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "swagger:export": "npm run build && NODE_ENV=dev SWAGGER_EXPORT=true node dist/main.js",
    "docker:dev": "docker compose -f docker/docker-compose.yml up --build",
    "docker:dev:down": "docker compose -f docker/docker-compose.yml down -v",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1005.0",
    "@clerk/backend": "^3.0.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/websockets": "^11.2.8",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cloudinary": "^2.9.0",
    "compression": "^1.7.4",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.0",
    "express-session": "^1.18.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.0.0",
    "nest-winston": "^1.10.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.0",
    "resend": "^6.9.3",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.4",
    "svix": "^1.86.0",
    "uuid": "^11.1.1",
    "winston": "^3.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.18",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/jest": "^29.5.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "husky": "^9.1.0",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.4.0",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.55.0"
  },
  "overrides": {
    "multer": "2.5.0",
    "@nestjs/swagger": {
      "js-yaml": "5.4.3"
    }
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@config/(.*)$": "<rootDir>/config/$1",
      "^@database/(.*)$": "<rootDir>/database/$1",
      "^@auth/(.*)$": "<rootDir>/auth/$1",
      "^@users/(.*)$": "<rootDir>/users/$1",
      "^@data-requests/(.*)$": "<rootDir>/data-requests/$1",
      "^@upload/(.*)$": "<rootDir>/upload/$1",
      "^@otp/(.*)$": "<rootDir>/otp/$1",
      "^@email/(.*)$": "<rootDir>/email/$1",
      "^@registration-session/(.*)$": "<rootDir>/registration-session/$1",
      "^@sellers/(.*)$": "<rootDir>/sellers/$1",
      "^@auth-events/(.*)$": "<rootDir>/auth-events/$1",
      "^@site-config/(.*)$": "<rootDir>/site-config/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@logger/(.*)$": "<rootDir>/logger/$1",
      "^@health/(.*)$": "<rootDir>/health/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1",
      "^@orders/(.*)$": "<rootDir>/orders/$1",
      "^@cart/(.*)$": "<rootDir>/cart/$1",
      "^@products/(.*)$": "<rootDir>/products/$1",
      "^@checkout/(.*)$": "<rootDir>/checkout/$1",
      "^@payments/(.*)$": "<rootDir>/payments/$1",
      "^@returns/(.*)$": "<rootDir>/returns/$1",
      "^@categories/(.*)$": "<rootDir>/categories/$1",
      "^@logistics/(.*)$": "<rootDir>/logistics/$1",
      "^@promo-slots/(.*)$": "<rootDir>/promo-slots/$1",
      "^@suppliers/(.*)$": "<rootDir>/suppliers/$1",
      "^@support/(.*)$": "<rootDir>/support/$1",
      "^@notifications/(.*)$": "<rootDir>/notifications/$1",
      "^@wallet/(.*)$": "<rootDir>/wallet/$1",
      "^@partners/(.*)$": "<rootDir>/partners/$1",
      "^@rewards/(.*)$": "<rootDir>/rewards/$1"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
