# Outbound notifications: copy these keys into your local .env or deployment secret store.
# Use provider test credentials while validating; never commit real keys.

# PostgreSQL. Use the Neon direct URL for migrations and the pooled URL for the API.
# For local development, use a local PostgreSQL URL in both variables.
# Direct Neon connection: used by Prisma migration commands.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/neondb?sslmode=require
# Pooled Neon connection: the API uses this when present.
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@POOLER_HOST:5432/neondb?sslmode=require

# Required application secrets. Generate a different random value for each key
# with: openssl rand -hex 32. Replace these placeholders in your local .env.
JWT_ACCESS_SECRET=REPLACE_WITH_A_UNIQUE_OPENSSL_RANDOM_VALUE
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_OPENSSL_RANDOM_VALUE
SESSION_SECRET=REPLACE_WITH_ANOTHER_UNIQUE_OPENSSL_RANDOM_VALUE

RESEND_API_KEY=
EMAIL_FROM=Cadna Mart <noreply@example.com>

# StackAPI SMS (send only for order and security notifications to verified phone numbers).
STACKAPI_SECRET_KEY=
STACKAPI_PUBLIC_KEY=
# StackAPI Logistics uses the same key pair above. Enable the Logistics service
# for the key in StackAPI. Keep test keys here while validating.
STACKAPI_LOGISTICS_BASE_URL=https://api.stackapi.app/v1/logistics
LOGISTICS_ALERT_EMAIL=
STACKAPI_KYC_MODE=test
STACKAPI_KYC_LIVE_ENABLED=false
STACKAPI_KYC_TEST_SECRET_KEY=Psk-test-replace_with_stackapi_test_secret_key
STACKAPI_KYC_LIVE_SECRET_KEY=
STACKAPI_KYC_TEST_PUBLIC_KEY=Ppk-test-replace_with_stackapi_test_public_key
STACKAPI_KYC_LIVE_PUBLIC_KEY=
STACKAPI_KYC_CONSENT_VERSION=2026-11-02

# Firebase Cloud Messaging. Use Application Default Credentials via
# GOOGLE_APPLICATION_CREDENTIALS (service-account file path) or workload identity.
FCM_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Clerk buyer sign-in. CLERK_JWT_KEY is the PEM public key from Clerk's API keys
# page; when stored as one line, replace newlines with literal \\n sequences.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWT_KEY=

# Seller bank lookup / payout account verification.
# Set SELLER_BANK_VERIFICATION_PROVIDER to exactly `paystack` or `nomba`.
# Configure credentials for the selected provider only. Keep all values server-side.
# Paystack: copy the backend Secret Key from Dashboard > Developers > API Keys.
# Test keys start with `sk_test_`; live keys start with `sk_live_`. This is a fake example.
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_PAYSTACK_SECRET_KEY
# Optional override; if blank, the backend verifies webhooks with PAYSTACK_SECRET_KEY.
PAYSTACK_WEBHOOK_SECRET=
# Optional deal payment return URL; leave blank to use the provider default.
PAYSTACK_CALLBACK_URL=
# Nomba: copy these three separate values from your Nomba API credentials page.
# The server uses client-credentials auth, then sends the Account ID with bank API requests.
NOMBA_ACCOUNT_ID=REPLACE_WITH_NOMBA_ACCOUNT_ID
NOMBA_CLIENT_ID=REPLACE_WITH_NOMBA_CLIENT_ID
NOMBA_CLIENT_SECRET=REPLACE_WITH_NOMBA_CLIENT_SECRET
# Example selects Paystack. Change to `nomba` when using the Nomba values above.
SELLER_BANK_VERIFICATION_PROVIDER=paystack
# AES-256-GCM key for encrypting seller payout account numbers; exactly 64 hex characters.
# Replace this placeholder with the output of: openssl rand -hex 32
SELLER_PII_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS_FROM_OPENSSL

# Staging and production Clerk verification require exact frontend origins.
# Set CORS_ORIGIN to the actual comma-separated buyer and seller site origins; do not use *.
CORS_ORIGIN=https://buyer-site.example,https://seller-site.example

# Cloudinary is required for product images and private seller/support documents.
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_CLOUDINARY_API_SECRET
